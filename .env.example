# Salin file ini menjadi .env pada konfigurasi lokal Anda. Jangan commit file .env ke Git repo.

# 1. Kredensial Database PostgreSQL (Mandatory)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/eticket?schema=public"

# 2. Port & URL Origin Aplikasi
API_PORT=4000
NEXT_PUBLIC_API_URL="http://localhost:4000"
WEB_ORIGIN="http://localhost:3000"

# 3. Third-Party: QRIS Payment Gateway (Midtrans Core API)
PAYMENT_API_BASE_URL="https://api.sandbox.midtrans.com"
PAYMENT_API_KEY="SB-Mid-server-YOUR_MIDTRANS_SERVER_KEY"
PAYMENT_WEBHOOK_SECRET="YOUR_MIDTRANS_WEBHOOK_SECRET"

# 4. Third-Party: Email Sending Library (Nodemailer / Resend SMTP)
SMTP_HOST="smtp.mailtrap.io"
SMTP_PORT=2525
SMTP_USER="YOUR_SMTP_USER"
SMTP_PASS="YOUR_SMTP_PASS"
EMAIL_FROM='"E-Tiket 2026 Official" <no-reply@eticket.id>'
